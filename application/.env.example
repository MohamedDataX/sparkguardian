# --- Core ---
# HMAC secret used to sign license tokens. Generate: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
# Bearer token protecting /admin
ADMIN_TOKEN=pick-a-strong-admin-token
# Public base URL of this app (used for Stripe redirects)
PUBLIC_URL=http://localhost:8000
# SQLite file location (optional)
# DATABASE_PATH=./sparkguardian.db
# Trial length in days
TRIAL_DAYS=7

# --- Stripe (test mode) ---
# From https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Recurring price id (e.g. price_123) for the $10/mo Pro plan
STRIPE_PRICE_ID=
# From `stripe listen` or the dashboard webhook settings
STRIPE_WEBHOOK_SECRET=
