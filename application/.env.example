# HMAC secret used to sign license tokens. Generate: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
# Bearer token protecting /admin
ADMIN_TOKEN=pick-a-strong-admin-token
# Public base URL of this app
PUBLIC_URL=http://localhost:8000
# SQLite file location (optional)
# DATABASE_PATH=./sparkguardian.db
